<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BLite.Server.Benchmarks</AssemblyName>
    <RootNamespace>BLite.Server.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.*" />
    <PackageReference Include="MongoDB.Driver"  Version="3.*"    />
  </ItemGroup>

  <ItemGroup>
    <!-- Client + transitive BLite.Proto (QueryDescriptor, BinaryFilter, ScalarValue…) -->
    <ProjectReference Include="..\..\src\BLite.Client\BLite.Client.csproj" />
  </ItemGroup>

</Project>
