<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BLite.Server.Benchmarks</AssemblyName>
    <RootNamespace>BLite.Server.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageReference Include="MongoDB.Driver" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Client + transitive BLite.Proto (QueryDescriptor, BinaryFilter, ScalarValue…) -->
    <ProjectReference Include="..\..\src\BLite.Client\BLite.Client.csproj" />
    <!-- Server — started in-process via WebApplicationFactory<Program> when no external server is detected -->
    <ProjectReference Include="..\..\src\BLite.Server\BLite.Server.csproj" />
  </ItemGroup>

</Project>
