<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BLite.Client</RootNamespace>
    <AssemblyName>BLite.Client</AssemblyName>

    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <Authors>BLite Team</Authors>
    <Company>EntglDb</Company>
    <Copyright>Copyright © 2026 Luca Fabbri</Copyright>
    <Description>.NET client SDK for BLite Server — provides typed access over gRPC.</Description>
    <RepositoryUrl>https://github.com/EntglDb/BLite.Server</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageTags>database;client;grpc;bson;nosql;blite</PackageTags>
  </PropertyGroup>

  <ItemGroup>    <InternalsVisibleTo Include="BLite.Client.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>    <!-- BLite engine — direct project reference (local workspace) -->
    <!-- gRPC proto definitions + QueryDescriptor -->
    <ProjectReference Include="..\..\..\BLite.Server\src\BLite.Proto\BLite.Proto.csproj" />
    <!-- Remote context source generator -->
    <ProjectReference Include="..\BLite.Client.SourceGenerators\BLite.Client.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- gRPC client channel -->
    <PackageReference Include="BLite" Version="3.6.4" ExcludeAssets="analyzers" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <!-- QueryDescriptor wire serialization (same options as server) -->
    <PackageReference Include="MessagePack" Version="3.1.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
