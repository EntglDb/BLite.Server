<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BLite.Server</RootNamespace>
    <AssemblyName>BLite.Server</AssemblyName>
    <OutputType>Exe</OutputType>

    <Version>0.1.7</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <Authors>BLite Team</Authors>
    <Company>EntglDb</Company>
    <Copyright>Copyright © 2026 Luca Fabbri</Copyright>
    <Description>High-performance self-hosted database server built on the BLite embedded engine. Exposes gRPC, REST API, and a Blazor Studio web UI.</Description>
    <RepositoryUrl>https://github.com/EntglDb/BLite.Server</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageTags>database;server;grpc;rest;blazor;bson;nosql;embedded;blite</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="data\**" />
    <Content Remove="data\**" />
    <EmbeddedResource Remove="data\**" />
    <None Remove="data\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="blite.db" />
    <None Remove="blite.wal" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BLite.Client.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BLite.Proto\BLite.Proto.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OS service integration (Windows Service + Linux systemd) -->
    <PackageReference Include="BLite" Version="3.6.6" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.*" />

    <!-- gRPC host -->
    <PackageReference Include="ErrorOr" Version="2.1.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <!-- gRPC reflection for grpcurl/tooling in Development -->
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.76.0" />

    <!-- MessagePack for QueryDescriptor deserialization -->
    <PackageReference Include="MessagePack" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <!-- Embedding: ONNX inference + HuggingFace tokenizer -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.3" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <!-- OpenTelemetry -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
    <!-- License validation -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.16.0" />
  </ItemGroup>

</Project>
