{
  "BLiteServer": {
    "DatabasePath": "blite.db",
    "MaxPageSizeBytes": 16384,
    "DatabasesDirectory": "data/tenants"
  },
  "Embedding": {
    "ModelDirectory": "Embedding/MiniLM-L6-v2",
    "MaxTokens": 512
  },
  "EmbeddingWorker": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "BatchSize": 50,
    "StaleTimeoutMinutes": 5,
    "RetentionHours": 24
  },
  "License": {
    "SourceUrl": "https://github.com/EntglDb/BLite.Server",
    "HubUrl": "https://licensehub.blitedb.com",
    "FilePath": "",
    "PublicKeyPem": ""
  },
  "Studio": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://*:2626",
        "Protocols": "Http2"
      },
      "Rest": {
        "Url": "http://*:2627",
        "Protocols": "Http1AndHttp2"
      },
      "Studio": {
        "Url": "http://*:2628",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "Telemetry": {
    "Enabled": true,
    "ServiceName": "blite-server",
    "Console": null,
    "Otlp": {
      "Endpoint": ""
    }
  },
  "Transactions": {
    "TimeoutSeconds": 60
  },
  "QueryCache": {
    "Enabled": true,
    "SlidingExpirationSeconds": 30,
    "AbsoluteExpirationSeconds": 300,
    "MaxSizeBytes": 67108864,
    "MaxResultSetSize": 500
  }
}
